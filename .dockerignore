# Segredos e ambiente local nunca entram na imagem
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
# Dependências e builds do host (a imagem instala/compila as próprias)
**/node_modules/
**/dist/
.venv/
venv/
**/.venv*/
**/__pycache__/
**/.pytest_cache/
