.git/
.claude/
.remember/
.logs/
graphify-out/
test-results/
playwright-report/
*.log
# Material de chave, binário da plataforma do host e estado gerado pelo seed
backend/secrets/
*.bin
backend/lib/
backend/venv/
backend/data/demo_seeds*.json
backend/data/bench.*.json
.github/
.playwright-mcp/
.ruff_cache/
