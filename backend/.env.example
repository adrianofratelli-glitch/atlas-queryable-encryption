# Cluster de demonstração DESCARTÁVEL. Queryable Encryption exige MongoDB 7.0+
# e, no Atlas, M10+. Não roda em Flex nem no tier gratuito; consulta por faixa
# só é GA a partir do 8.0.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
QE_DB=cofre
MONGO_TIMEOUT_MS=8000

# ── Cofre de chaves ──────────────────────────────────────────────────────────
QE_KEY_VAULT_NS=cofre.__keyVault

# `local` roda em qualquer notebook, sem conta de nuvem, e NÃO É PARA PRODUÇÃO:
# a chave mestra em disco ao lado da aplicação anula boa parte do modelo de
# ameaça. `aws` é o que o cliente vai usar.
QE_KMS_PROVIDER=local

# A chave mestra local NÃO fica aqui. Fica em arquivo próprio, gerado por
# scripts/gerar-master-key.py e ignorado pelo git — um .env vaza em screenshot
# com uma facilidade que 96 bytes em outro arquivo não perdoa.
QE_LOCAL_MASTER_KEY_PATH=./secrets/master-key.bin

# Biblioteca de criptografia do lado do cliente. Rode
# scripts/instalar-crypt-shared.sh. Passamos crypt_shared_lib_required=True: sem
# ela o driver cairia silenciosamente para o mongocryptd, que sobe um processo
# órfão em :27020 e falha depois de um jeito que parece problema de rede.
CRYPT_SHARED_PATH=./lib/mongo_crypt_v1.dylib

# ── AWS KMS (somente com QE_KMS_PROVIDER=aws) ────────────────────────────────
AWS_KMS_KEY_ARN=
AWS_KMS_REGION=sa-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Ajustes da demo ──────────────────────────────────────────────────────────
# Partições de metadados por campo: mais aliviam contenção de escrita e obrigam
# a leitura a varrer mais partições. IMUTÁVEL depois do create_collection —
# mudar aqui exige dropar e recriar a coleção.
QE_CONTENTION_FACTOR=8
# Amostra do benchmark do módulo 06.
QE_BENCH_DOCS=500
# Rótulo do cluster que acompanha todo número do módulo 06. Número de latência
# ou de storage sem o tier ao lado não significa nada na reunião.
QE_CLUSTER_TIER=M10 (AWS sa-east-1)

# ── Segurança e operação ─────────────────────────────────────────────────────
# Sem token, mutações só são aceitas de localhost e das origens abaixo.
DEMO_ADMIN_TOKEN=
ALLOWED_ORIGINS=http://localhost:5300,http://127.0.0.1:5300
MAX_REQUEST_BYTES=1048576
